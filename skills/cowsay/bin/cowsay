#!/usr/bin/env python3
"""cowsay — un archivo, stdlib, caja redondeada, ancho real de emoji y CJK."""
import argparse, os, shutil, sys, unicodedata

COWS = {
    "default": r"""
        {t}   ^__^
         {t}  ({e})\_______
            (__)\       )\/\
             {g} ||----w |
                ||     ||""",
    "tux": r"""
   {t}
    {t}   .--.
       |{e1}_{e2} |
       |:_/ |
      //   \ \
     (|     | )
    /'\_   _/`\
    \___)=(___/""",
    "moose": r"""
  {t}
   {t}   \_\_    _/_/
    {t}      \__/
           ({e})\_______
           (__)\       )\/\
            {g} ||----w |
               ||     ||""",
    "cat": r"""
  {t}
   {t}  /\_/\
      ( {e1}.{e2} )
       > ^ <""",
    "koala": r"""
  {t}
   {t}   ___
     {{~{e1}_{e2}~}}
      ( Y )
     (:_~_:)
     (_)-(_)""",
}
MOODS = {  # ojos, lengua, título por defecto
    "": ("oo", "  ", ""),
    "ok": ("^^", "  ", "✔ ÉXITO"),
    "fail": ("xx", "U ", "✘ FALLO"),
    "warn": ("OO", "  ", "⚠ ATENCIÓN"),
    "think": ("--", "  ", ""),
}

def w(s):
    n = 0
    for ch in s:
        if unicodedata.combining(ch) or ch in "‍️":
            continue
        n += 2 if unicodedata.east_asian_width(ch) in "WF" or ord(ch) >= 0x1F300 else 1
    return n

def wrap(text, width):
    out = []
    for para in text.expandtabs(4).splitlines() or [""]:
        line = ""
        for word in para.split(" "):
            cand = f"{line} {word}" if line else word
            if w(cand) <= width:
                line = cand
                continue
            if line:
                out.append(line)
            while w(word) > width and not word.startswith(("http://", "https://", "/", "~")):
                cut = 0
                while w(word[: cut + 1]) <= width:
                    cut += 1
                out.append(word[:cut]); word = word[cut:]
            line = word
        out.append(line)
    while out and not out[-1]:
        out.pop()
    return out or [""]

def bubble(lines, title, think):
    inner = max(max(w(l) for l in lines), w(title) + 2 if title else 0)
    if title:
        top = f"╭─ {title} " + "─" * (inner - w(title) - 1) + "╮"
    else:
        top = "╭" + "─" * (inner + 2) + "╮"
    l, r = ("(", ")") if think else ("│", "│")
    body = [f"{l} {s}{' ' * (inner - w(s))} {r}" for s in lines]
    return [top, *body, "╰" + "─" * (inner + 2) + "╯"]

def main():
    p = argparse.ArgumentParser(prog="cowsay")
    p.add_argument("text", nargs="*")
    p.add_argument("-f", "--cow", default=os.environ.get("COWSAY_COW", "default"))
    p.add_argument("-t", "--title", default=None)
    p.add_argument("-W", "--width", type=int)
    p.add_argument("-l", "--list", action="store_true")
    g = p.add_mutually_exclusive_group()
    for m in ("ok", "fail", "warn", "think"):
        g.add_argument(f"--{m}", action="store_true")
    a = p.parse_args()
    if a.list:
        print(" ".join(COWS)); return
    if a.cow not in COWS:
        sys.exit(f"cowsay: no existe '{a.cow}'. Hay: {' '.join(COWS)}")
    mood = next((m for m in ("ok", "fail", "warn", "think") if getattr(a, m)), "")
    eyes, tongue, deftitle = MOODS[mood]
    title = deftitle if a.title is None else a.title
    text = " ".join(a.text) if a.text else sys.stdin.read()
    cols = shutil.get_terminal_size((80, 24)).columns
    width = max(12, min(a.width or int(os.environ.get("COWSAY_WIDTH", 0)) or cols - 6, 72))
    box = bubble(wrap(text.rstrip("\n"), width), title, mood == "think")
    art = COWS[a.cow].lstrip("\n").format(
        t="o" if mood == "think" else "\\", e=eyes, e1=eyes[0], e2=eyes[1], g=tongue)
    print("\n".join(box) + "\n" + art.rstrip())

if __name__ == "__main__":
    main()
